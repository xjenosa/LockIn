# Copy to .env.local and fill in.

# Neon Postgres connection string: Neon console -> your project -> Connect.
# The pooled host (it has "-pooler" in it) is the one to use.
#
# SERVER-ONLY. This is a database credential, so it must NOT be renamed with a
# NEXT_PUBLIC_ prefix -- that prefix ships a variable to the browser, which
# would publish your database password to every player's phone. Nothing in the
# client bundle reads it; only the route handlers under app/api/ do.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional but recommended once deployed: the canonical PUBLIC url of the site.
# The join QR code is built from this. Leave it unset and the QR inherits
# whatever url the host happens to be browsing. Open a Vercel *preview* link by
# mistake and every player who scans gets a Vercel login prompt instead of the
# game, because previews are protected by default. Set it to the production
# domain and that can't happen. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
