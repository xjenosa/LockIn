# Copy to .env.local and fill in from Supabase -> Project Settings -> API
# URL must be the BARE project URL (no /rest/v1/ suffix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional but recommended once deployed: the canonical PUBLIC url of the site.
# The join QR code is built from this. Leave it unset and the QR inherits
# whatever url the host happens to be browsing. Open a Vercel *preview* link by
# mistake and every player who scans gets a Vercel login prompt instead of the
# game, because previews are protected by default. Set it to the production
# domain and that can't happen. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional: locks down the /api/keep-alive cron route (see vercel.json). Set this
# to any random string in Vercel's env settings and Vercel automatically sends it
# as a Bearer token on the daily cron request; unauthenticated pings are then
# refused. Leave it unset and the route stays open (harmless — it only reads the
# server clock). Server-only, so NOT prefixed NEXT_PUBLIC.
# CRON_SECRET=some-long-random-string
